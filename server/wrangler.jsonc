{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"d1_databases": [
		{
			"binding": "chat",
			"database_name": "chat",
			"database_id": "48234fa6-c98c-42fc-895d-19583b27087c",
			"remote": true
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyDurableObject"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Channel",
				"name": "CHANNEL"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
